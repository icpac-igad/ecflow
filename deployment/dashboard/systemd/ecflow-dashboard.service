[Unit]
Description=E4DRR ecFlow GIK monitor dashboard
After=network.target
[Service]
Environment=DASH_PORT=8090
Environment=DASH_BIND=0.0.0.0
Environment=ECFLOW_HTTP=http://localhost:8080/v1
ExecStart=/usr/bin/python3 /home/hkoros/e4drr-ecflow-dashboard/dashboard_server.py
Restart=always
[Install]
WantedBy=default.target
