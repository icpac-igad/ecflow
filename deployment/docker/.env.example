# E4DRR ecFlow deployment — single source of configuration.
# Copy to .env and adjust. .env is gitignored; .env.example is the tracked contract.

# ---- image ----------------------------------------------------------------
ECFLOW_VERSION=5.18.0
ECFLOW_IMAGE=e4drr/ecflow:5.18.0

# ---- engine (module 1) ----------------------------------------------------
# ECF_PORT is the server's TCP port. ecFlow derives a second port (ECF_PORT+1)
# for its internal use, so leave a gap when running more than one server.
ECF_PORT=3141

# Host path holding ECF_HOME: suite scripts, generated jobs, job output, the
# checkpoint (ecf.check/.b) and the log. This is the state that must survive
# container replacement — back it up, do not delete it casually.
ECF_DATA_DIR=./data

# Bind address for the default (localhost-only) stack.
ECF_BIND=127.0.0.1

# Extra interfaces, used ONLY by docker-compose.crafd.yml (`make up-crafd`).
# Explicit addresses, not 0.0.0.0 — ufw is inactive on crafd-gpu, so the bind is
# the access control. Leave these unset on any host that is not crafd-gpu.
ECF_BIND_TAILSCALE=100.65.116.127
ECF_BIND_LAN=10.10.3.90

# Stable node name. ecFlow derives its checkpoint/log/white-list filenames from
# the hostname; if that is the container ID, recreating the container orphans the
# checkpoint and silently loses every suite. Do not change this on a live server
# without moving the ecf.check files to match.
ECF_NODENAME=e4drr-ecflow

# Memory ceiling. The engine is a ~1 GB process; the cap exists so a runaway
# suite can never contend with the GPU workload sharing this server.
ECF_MEM_LIMIT=4g
ECF_CPU_LIMIT=4

# ---- REST proxy (module 2) ------------------------------------------------
# Stateless: opens a fresh client connection per request, holds no workflow
# state, so it can be restarted or replaced freely.
ECF_HTTP_PORT=8080
ECF_HTTP_BIND=127.0.0.1
ECF_HTTP_MEM_LIMIT=512m

# ---- UDP telemetry ingress (module 3, phase 2) ----------------------------
# Only needed once tasks run off this box and report progress via ecflow-light.
ECF_UDP_PORT=19999
ECF_UDP_BIND=127.0.0.1

# ---- identity -------------------------------------------------------------
# Container runs as this uid/gid so files written into ECF_DATA_DIR are owned
# by you on the host. Defaults match hkoros on e4drr-crafd-icpac.
HOST_UID=1001
HOST_GID=1001
